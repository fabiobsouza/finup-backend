# FinUp API - Variáveis de ambiente
# Copie este arquivo para .env (está no .gitignore) e preencha os valores.
#
# Quem lê este arquivo:
#  - a aplicação, ao rodar localmente a partir desta pasta (spring.config.import);
#  - o docker-compose, para DB_USER / DB_PASS / JWT_SECRET (o compose fixa o profile prod).
# Variáveis de ambiente reais têm precedência sobre os valores daqui.
# Formato: CHAVE=valor, sem aspas.

# Profile Spring Boot (dev | prod). Em dev a aplicação usa o banco dbmaindev.
SPRING_PROFILES_ACTIVE=dev

# Banco de dados
DB_USER=finup_user
DB_PASS=sua_senha_aqui

# JWT — gere uma chave aleatória com: openssl rand -base64 48
JWT_SECRET=coloque_uma_chave_secreta_forte_com_pelo_menos_32_caracteres_aqui
